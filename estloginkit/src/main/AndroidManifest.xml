<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <queries>
    <!-- 카카오톡 앱 로그인 가용성 체크 -->
    <package android:name="com.kakao.talk" />

    <!--
      Android 11+ 패키지 가시성 대응.
      네이버 SDK(NidApplicationUtil.getCustomTabsPackageList)는
      queryIntentActivities(Intent(ACTION_VIEW, http://...)) 결과에서
      CustomTabsService 가능 패키지를 추려내는데, 이 intent 가
      manifest 의 <queries> 에 선언돼 있지 않으면 Android 11+ 에서는
      결과가 빈 리스트로 돌아온다. 네이버 공식 가이드도 동일한 선언을 요구한다.
    -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="http" />
    </intent>
  </queries>

  <application>
    <!--
      configChanges — 구성 변경으로 Activity 가 재생성되면 WebView 가 새로 만들어지면서 최초 URL 로
      되돌아간다(WebViewScreen 의 AndroidView factory 는 항상 loadUrl(url) 로 시작한다). 네이버
      보안문자처럼 여러 단계를 거치는 로그인 흐름이 화면 회전·멀티윈도우/폴더블·다크모드·폰트 크기
      변경만으로 처음부터 다시 시작되는 것을 막는다. Compose 는 이 플래그가 있어도 구성 변경을
      LocalConfiguration 으로 받아 UI 를 갱신하므로 레이아웃 대응에는 문제가 없다.
      (프로세스 사망으로 인한 재생성은 이걸로 막을 수 없다 — 별도 saveState/restoreState 필요)
    -->
    <activity
      android:name="com.estaid.loginkit.internal.webview.WebViewActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale|keyboard|keyboardHidden|navigation"
      android:exported="false"
      android:theme="@style/Theme.EstLoginKit" />

    <activity
      android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:host="oauth"
          android:scheme="${kakaoAuthScheme}" />
      </intent-filter>
    </activity>
  </application>

</manifest>
